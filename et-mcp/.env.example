DATABASE_URL=postgres://...neon.tech/...
PORT=3001
MCP_TRANSPORT=http
NODE_ENV=development
LOG_LEVEL=info

# Only used when MCP_TRANSPORT=stdio (Claude Desktop / Inspector dev)
MCP_API_KEY=etmcp_...

# Shared secret for internal JWTs minted by the expense-tracker in-app chat.
